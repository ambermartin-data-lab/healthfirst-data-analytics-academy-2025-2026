    {
      "cell_type": "code",
      "source": [
        "# Ensure 'Mean Score' is numeric and handle missing values before plotting\n",
        "df[\"Mean Score\"] = pd.to_numeric(df[\"Mean Score\"], errors=\"coerce\")\n",
        "df_cleaned_for_plot = df.dropna(subset=[\"Mean Score\"])\n",
        "\n",
        "school_mean_score = df_cleaned_for_plot.groupby('School Name')['Mean Score'].mean().sort_values(ascending=False)\n",
        "\n",
        "# Creating readable layout for bar chart\n",
        "\n",
        "plt.figure(figsize=(12, 6))\n",
        "school_mean_score.head(10).plot(kind='bar')\n",
        "plt.title('Top 10 Schools by Mean Score')\n",
        "plt.xlabel('School Name')\n",
        "plt.ylabel('Mean Score')\n",
        "plt.xticks(rotation=45, ha='right')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 607
        },
